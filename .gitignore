# --- 1. Security (CRITICAL) ---
# Never upload API keys or secrets
.env
.env.local
.env.*
!.env.example

# --- 2. Python / Backend ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/
.env/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Flask
instance/
.webassets-cache

# --- 3. Project Specific (PPT Avatar) ---
# Ignore uploaded files to save space & privacy
uploads/*
# But keep the folder structure (requires creating .gitkeep inside uploads/)
!uploads/.gitkeep

# Ignore locally generated slides (since we use Supabase now)
slides/*
!slides/.gitkeep

# Ignore local database file if using SQLite (not needed for Supabase, but good practice)
*.sqlite3
*.db

# --- 4. OS / IDE Settings ---
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/

# --- 5. Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*